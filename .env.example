# Local development template. Copy it: cp .env.example .env
# Production values live in Dokploy's Environment tab (docs/DEPLOYMENT.md), never in the repo.

# PostgreSQL (Docker Compose)
POSTGRES_USER=beljot
POSTGRES_PASSWORD=beljot_dev_password
POSTGRES_DB=beljot

# Application
BELJOT_DB_URL=postgres://beljot:beljot_dev_password@localhost:5433/beljot?sslmode=disable
BELJOT_JWT_SECRET=change-me-in-production
BELJOT_PORT=8080
BELJOT_CORS_ORIGINS=http://localhost:5173
BELJOT_ENV=development

# Token lifetimes (Go duration strings; no day unit — express days as hours).
# Access JWTs stay short and renew silently. Refresh tokens rotate on every use
# with a sliding idle window (BELJOT_REFRESH_IDLE_TTL) and a hard cap from login
# (BELJOT_REFRESH_ABSOLUTE_TTL) that forces a periodic re-login.
BELJOT_ACCESS_TOKEN_TTL=15m
BELJOT_REFRESH_IDLE_TTL=720h
BELJOT_REFRESH_ABSOLUTE_TTL=4320h

# Public frontend origin, used to build links in outgoing email (no trailing slash).
# Dev: http://localhost:5173 — Prod: https://beljot.online
BELJOT_APP_BASE_URL=http://localhost:5173

# Google SSO — the OAuth client ID (the *.apps.googleusercontent.com value, NOT
# the client secret; the GIS ID-token flow needs no secret). Used server-side as
# the required token audience. Leave empty to disable Google sign-in. The same
# ID goes in client/.env as VITE_GOOGLE_CLIENT_ID for the button.
BELJOT_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Email / SMTP (password-reset and other transactional mail).
# Leave HOST/USERNAME/PASSWORD blank to fall back to logging the reset link to
# stdout instead of sending — handy in dev without real credentials.
# Gmail: host=smtp.gmail.com, port=587 (STARTTLS), username=<full address>,
# password=<16-char Google "App password", NOT your account password>.
BELJOT_SMTP_HOST=
BELJOT_SMTP_PORT=587
BELJOT_SMTP_USERNAME=
BELJOT_SMTP_PASSWORD=
BELJOT_SMTP_FROM=you@example.com
BELJOT_SMTP_FROM_NAME=Beljot.online

# Garage (Docker Compose) — local S3-compatible object store for avatars.
# Defaults live in docker-compose.yml; override here only if you change them.
# One-time after the first `docker compose up -d`, make the bucket web-servable:
#   docker compose exec garage /garage bucket website --allow beljot-public
GARAGE_DEFAULT_ACCESS_KEY=GK0123456789abcdef01234567
GARAGE_DEFAULT_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Avatar storage (the same six variables exist in Dokploy for production).
# Leave BELJOT_S3_ENDPOINT empty to run without Garage: avatar endpoints answer 503.
# Browsers resolve *.localhost to loopback, so the public URL works without hosts edits.
BELJOT_S3_ENDPOINT=http://localhost:3900
BELJOT_S3_REGION=garage
BELJOT_S3_ACCESS_KEY=GK0123456789abcdef01234567
BELJOT_S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BELJOT_S3_PUBLIC_BUCKET=beljot-public
BELJOT_PUBLIC_ASSETS_URL=http://beljot-public.web.garage.localhost:3902
